// The envelope builds everything from this file: context, keys, encryption.
// It is read once per point, before anything is measured. `//` starts a
// comment. Parameters marked for another scheme are ignored.
{
  // Encryption scheme: "ckks" | "bgv" | "bfv" | "fhew".
  //   ckks    — approximate arithmetic over real numbers.
  //   bgv/bfv — exact arithmetic over integers modulo plaintext_modulus.
  //   fhew    — one bit per ciphertext, every gate a bootstrap (binfhe).
  // Your encoding/run/decoding must match what is named here.
  "scheme": "fhew",

  // Security floor, enforced by OpenFHE at context creation: a parameter set
  // that does not reach it is refused before anything runs. The specification
  // may demand a minimum; going below it fails acceptance.
  //   "HEStd_128_classic" | "HEStd_192_classic" | "HEStd_256_classic"
  "security": "HEStd_128_classic",

  // ── all schemes ──────────────────────────────────────────────────────────

  // Ring dimension, a power of two. More slots and more room for depth at
  // the declared security level; slower and larger in the same measure.
  "ring_dimension": 16384,

  // Multiplicative depth: how many multiplications deep run() goes before
  // the levels run out. Each level costs modulus bits, and the ring must
  // carry them at the declared security — OpenFHE refuses what does not fit.
  "mult_depth": 2,

  // Slots packed per ciphertext. ckks: at most ring_dimension / 2.
  // bgv/bfv: divides the slot count, at most ring_dimension.
  "batch_size": 8192,

  // Evaluation keys, declared here and generated by the envelope:
  // multiplication (relinearization) keys are always made; the rest only on
  // request, because every key set costs generation time and memory.

  // Rotation indexes run() uses with EvalRotate. Keys are generated for
  // exactly this list; rotating by an undeclared index fails at run time.
  // Negative rotates the other way. Example: [1, -1, 2, 4]
  "rotation_key_indexes": [],

  // Keys for EvalSum — summing across the packed slots, e.g. the reduction
  // of a dot product. Off unless run() calls EvalSum.
  "generate_sum_keys": false,

  // ── ckks only ────────────────────────────────────────────────────────────

  // Bits of scale per level: the precision every intermediate value carries.
  "scale_mod_size": 50,

  // Bits of the first modulus: the precision the final result is read at.
  // Must be larger than scale_mod_size.
  "first_mod_size": 60,

  // Rescaling strategy:
  //   "FLEXIBLEAUTO" | "FLEXIBLEAUTOEXT" | "FIXEDAUTO" | "FIXEDMANUAL"
  // FLEXIBLEAUTO fits most circuits; FIXEDMANUAL means run() rescales itself.
  "scaling_technique": "FLEXIBLEAUTO",

  // Bootstrapping refreshes spent levels so run() can go deeper than
  // mult_depth. When true, the envelope sizes the context as the bootstrap
  // depth plus levels_available_after_bootstrap, generates the bootstrap
  // keys, and run() may call EvalBootstrap. Slow and memory-hungry.
  "enable_bootstrapping": false,

  // Bootstrap decomposition, [coefficients-to-slots, slots-to-coefficients].
  // [4, 4] is the usual starting point; smaller budgets keep more levels but
  // bootstrap slower.
  "level_budget": [4, 4],

  // Levels run() still has after each bootstrap.
  "levels_available_after_bootstrap": 10,

  // ── bgv / bfv only ───────────────────────────────────────────────────────

  // The plaintext space: arithmetic is exact modulo this number. Prime, and
  // 1 mod 2*ring_dimension for slot packing — 65537 fits every power-of-two
  // ring up to 32768.
  "plaintext_modulus": 65537,

  // Highest secret-key power the relinearization keys cover. 2 is enough
  // unless run() multiplies repeatedly without relinearizing between.
  "max_relin_sk_deg": 2,

  // ── fhew ─────────────────────────────────────────────────────────────────

  // The predefined parameter set. It fixes the LWE and RGSW dimensions, the
  // moduli, the key-switching base and the failure probability, and its name
  // carries the security level — so `security` above is not read for this
  // scheme, and a specification that demands a floor is met by choosing a set
  // that reaches it.
  //   "STD128" | "STD128Q" | "STD192" | "STD256" | the LPF_ sets for a lower
  //   failure probability | the _LMKCDEY sets, which take that method alone.
  // Read by name, which OpenFHE has been able to do since 1.6.0; an earlier
  // image cannot build this scheme.
  "parameter_set": "STD128",

  // The blind-rotation method, and the thing a board here compares.
  //   "GINX"    — OpenFHE's TFHE (CGGI) variant.
  //   "LMKCDEY" — the optimised FHEW (DM) variant, ia.cr/2022/198.
  //   "AP"      — the original Ducas-Micciancio.
  // A set whose name ends in _LMKCDEY is tuned for LMKCDEY and takes no other.
  "method": "GINX",

  // Worker threads for the library's OpenMP regions. 0 leaves the machine's
  // own setting alone. One gate parallelises over the gadget digits of a
  // single ciphertext and there are only a handful, so it stops gaining at
  // about eight; a run of many gates uses a larger machine through them.
  "threads": 1
}
